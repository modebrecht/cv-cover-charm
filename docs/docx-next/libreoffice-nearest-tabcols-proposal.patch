+// Proposal only: requires a source build, broader Writer tests and upstream review.
+// Round the mapped boundary instead of truncating an already rounded UNO position.
+template<class T>
+T lcl_MulDiv64Nearest(sal_uInt64 nA, sal_uInt64 nM, sal_uInt64 nD)
+{
+    assert(nD != 0);
+    const sal_uInt64 nProduct = nA * nM;
+    if (nD == 0)
+        return static_cast<T>(nProduct);
+    const sal_uInt64 nRemainder = nProduct % nD;
+    return static_cast<T>(nProduct / nD + (nRemainder >= nD - nRemainder));
+}
