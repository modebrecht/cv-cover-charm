+        }
diff --git a/tests/unit/docx-next-cover-regions.test.ts b/tests/unit/docx-next-cover-regions.test.ts
new file mode 100644
index 0000000..b22e1b0
--- /dev/null
+++ b/tests/unit/docx-next-cover-regions.test.ts
@@ -0,0 +1,99 @@
+import { describe, expect, test } from "bun:test";
+import { buildDossierDocModel } from "../../src/lib/docx-next/build-model";
+import { renderDossierDocx } from "../../src/lib/docx-next/renderer";
+import { validateDossierDocModel } from "../../src/lib/docx-next/validation";
+import { NEXT_TEMPLATES } from "../../src/lib/docx-next/templates";
+import { walkBlocks, type TableBlock } from "../../src/lib/docx-next/model";
+import { graphicCandidateFixture } from "../fixtures/docx-next/graphic-candidate";
+
+const option = { coverComposition: "authored-regions" as const };
+const region = (model: ReturnType<typeof buildDossierDocModel>, id: string) =>
+  model.cover.blocks.find((b) => b.id === id + ".region") as TableBlock;
+const fields = (model: ReturnType<typeof buildDossierDocModel>) =>
+  walkBlocks(model.cover.blocks)
+    .filter((b) => b.kind === "paragraph")
+    .map((b) => ({ id: b.id, runs: b.runs }))
+    .sort((a, b) => a.id.localeCompare(b.id));
+
+describe("Item 37 authored cover candidate", () => {
+  test("all 39 candidates retain semantic runs, source JSON and both neighboring models", () => {
+    expect(Object.keys(NEXT_TEMPLATES)).toHaveLength(39);
+    for (const id of Object.keys(NEXT_TEMPLATES)) {
+      const input = graphicCandidateFixture(id);
+      const before = JSON.stringify(input);
+      const base = buildDossierDocModel(input);
+      const model = buildDossierDocModel(input, option);
+      validateDossierDocModel(model);
+      expect(fields(model), id).toEqual(fields(base));
+      expect(model.letter, id).toEqual(base.letter);
+      expect(model.cv, id).toEqual(base.cv);
+      expect(buildDossierDocModel(JSON.parse(before), option), id).toEqual(model);
+      expect(JSON.stringify(input), id).toBe(before);
+    }
+  });
+  test("Brief restores independent top date and both authored lower lanes", () => {
+    const model = buildDossierDocModel(graphicCandidateFixture("brief"), option);
+    expect(region(model, "cover.ortDatum").pageRegion).toMatchObject({ xMm: 110, yMm: 19.5 });
+    const left = region(model, "cover.kontaktTitel").pageRegion!;
+    const right = region(model, "cover.beilagenTitel").pageRegion!;
+    expect(left.xMm).toBe(20);
+    expect(right.xMm).toBe(110);
+    expect(left.yMm).toBeGreaterThan(240);
+    expect(right.yMm).toBe(left.yMm);
+    expect(region(model, "cover.profession").pageRegion!.yMm).toBeGreaterThan(120);
+    expect(walkBlocks(model.cover.blocks).filter((b) => b.kind === "spacer")).toHaveLength(0);
+  });
+  test("manual saved attachment coordinates override automatic anchor links", () => {
+    const input = graphicCandidateFixture("brief");
+    for (const id of ["beilagenTitel", "beilagen"])
+      Object.assign(input.cover.blocks.find((b) => b.id === id)!.style, {
+        x: 120,
+        y: id === "beilagenTitel" ? 210 : 220,
+        w: 65,
+        above: null,
+        follows: null,
+        anchorBottom: false,
+      });
+    const model = buildDossierDocModel(input, option);
+    expect(region(model, "cover.beilagen").pageRegion).toMatchObject({ xMm: 120, yMm: 220 });
+    expect(region(model, "cover.beilagen").widthMm).toBe(65);
+  });
+  test("hidden attachments remain stored but emit no native region", () => {
+    const input = graphicCandidateFixture("brief");
+    input.cover.data.beilagen = ["Eigene Beilage"];
+    input.cover.data.showBeilagenOnCover = false;
+    const model = buildDossierDocModel(input, option);
+    expect(region(model, "cover.beilagen")).toBeUndefined();
+    expect(input.cover.data.beilagen?.length).toBeGreaterThan(0);
+  });
+  test("an oversized authored attachment region fails explicitly without clipping or shrink", () => {
+    const input = graphicCandidateFixture("brief");
+    input.cover.blocks.find((b) => b.id === "beilagen")!.lines = Array.from(
+      { length: 80 },
+      (_, i) => "Unterlage " + i,
+    );
+    expect(() => buildDossierDocModel(input, option)).toThrow("exceeds physical page bounds");
+  });
+  test("native ownership rejects invalid, nested and cross-document regions", () => {
+    const model = buildDossierDocModel(graphicCandidateFixture("brief"), option);
+    const invalid = structuredClone(model);
+    region(invalid, "cover.beilagen").pageRegion!.xMm = 250;
+    expect(() => validateDossierDocModel(invalid)).toThrow("invalid authored cover region");
+    const foreign = structuredClone(model);
+    foreign.cv.blocks.push(structuredClone(region(model, "cover.beilagen")));
+    expect(() => validateDossierDocModel(foreign)).toThrow();
+    const nested = structuredClone(model);
+    region(nested, "cover.kontakt").rows[0].cells[0].push(
+      structuredClone(region(model, "cover.beilagen")),
+    );
+    expect(() => validateDossierDocModel(nested)).toThrow();
+  });
+  test("the candidate remains renderer-guarded and the default cover retains flow", async () => {
+    const input = graphicCandidateFixture("brief");
+    const base = buildDossierDocModel(input);
+    expect(base.cover.blocks.some((b) => b.kind === "table" && b.pageRegion)).toBe(false);
+    await expect(renderDossierDocx(buildDossierDocModel(input, option))).rejects.toThrow(
+      "authored cover regions are unaccepted",
+    );
+  });
+});
