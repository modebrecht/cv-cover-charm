@@ -0,0 +1,115 @@
+import type { DossierCoverSource } from "./source";
+import type { DocBlock, DocumentPart, Paragraph } from "./model";
+import { walkBlocks } from "./model";
+import { nativeTextHeightMm } from "./layouts";
+
+/** Diagnostic cover placement from saved design intent, never measured Web/PDF rectangles. */
+export function authoredCoverRegions(
+  blocks: DocBlock[],
+  cover: DossierCoverSource,
+  page: DocumentPart["page"],
+): DocBlock[] {
+  const aliases: Record<string, string> = { name: "fullName", beruf: "profession", foto: "photo" };
+  const key = (id: string) => "cover." + (aliases[id] ?? id);
+  const byId = new Map(cover.blocks.map((block) => [block.id, block]));
+  const fieldBlocks = (id: string) =>
+    blocks.filter((block) => block.id === key(id) || block.id.startsWith(key(id) + "."));
+  const fieldParagraphs = (id: string) =>
+    walkBlocks(fieldBlocks(id)).filter((block): block is Paragraph => block.kind === "paragraph");
+  const heights = new Map(
+    cover.blocks.map((block): [string, number] => [
+      block.id,
+      block.kind === "shape" || block.kind === "photo" || block.kind === "image"
+        ? block.style.w * (block.style.ratio ?? 1)
+        : nativeTextHeightMm(
+            fieldParagraphs(block.id).map((p) => ({ ...p, beforeMm: 0, afterMm: 0 })),
+            block.style.w,
+          ),
+    ]),
+  );
+  const positions = new Map<string, number>();
+  const visiting = new Set<string>();
+  const top = (id: string): number => {
+    const cached = positions.get(id);
+    if (cached !== undefined) return cached;
+    const source = byId.get(id);
+    if (!source) throw new Error("DOCX Next missing authored cover anchor " + id);
+    if (visiting.has(id)) throw new Error("DOCX Next cyclic authored cover anchor " + id);
+    visiting.add(id);
+    const s = source.style;
+    const height = heights.get(id) ?? 0;
+    let y = s.anchorBottom ? s.y - height : s.y;
+    const target = s.follows || s.above;
+    if (target && byId.has(target))
+      y = s.follows
+        ? top(target) + (heights.get(target) ?? 0) + (s.gap ?? 4)
+        : top(target) - height - (s.gap ?? 2);
+    visiting.delete(id);
+    positions.set(id, y);
+    return y;
+  };
+  for (const source of cover.blocks) top(source.id);
+  const contact = byId.get("kontaktTitel");
+  const title = byId.get("beilagenTitel");
+  const body = byId.get("beilagen");
+  // Same automatic semantic relationship as the editor; explicit moves clear these links.
+  if (
+    contact &&
+    title &&
+    body &&
+    fieldParagraphs(contact.id).length &&
+    title.style.above === "beilagen" &&
+    !title.style.follows &&
+    body.style.anchorBottom
+  ) {
+    positions.set(title.id, top(contact.id));
+    positions.set(body.id, top(contact.id) + (heights.get(title.id) ?? 0) + (title.style.gap ?? 2));
+  }
+  const result: DocBlock[] = blocks.filter((block) => block.kind === "decorative-shape");
+  for (const source of cover.blocks) {
+    if (source.kind === "shape") continue;
+    const content = fieldBlocks(source.id);
+    if (!content.length) continue;
+    const y = top(source.id);
+    const height = heights.get(source.id) ?? 0;
+    const s = source.style;
+    if (
+      ![s.x, y, s.w, height].every(Number.isFinite) ||
+      s.x < 0 ||
+      y < 0 ||
+      s.w < 10 ||
+      s.x + s.w > page.widthMm + 0.01 ||
+      y + height > page.heightMm + 0.01
+    )
+      throw new Error(
+        "DOCX Next authored cover region exceeds physical page bounds: " + key(source.id),
+      );
+    const clearFlowLeads = (values: DocBlock[]): DocBlock[] =>
+      values.map((block) => {
+        if (block.kind === "paragraph") return { ...block, beforeMm: 0, afterMm: 0 };
+        if (block.kind === "image")
+          return { ...block, widthMm: s.w, maxHeightMm: s.w * (s.ratio ?? 1) };
+        if (block.kind === "table")
+          return {
+            ...block,
+            widthMm: s.w,
+            indentMm: 0,
+            rows: block.rows.map((row) => ({
+              ...row,
+              cells: row.cells.map(clearFlowLeads),
+            })),
+          };
+        return block;
+      });
+    result.push({
+      kind: "table",
+      id: key(source.id) + ".region",
+      widths: [1],
+      widthMm: s.w,
+      pageRegion: { xMm: s.x, yMm: y, bottomMm: page.heightMm },
+      rows: [{ cells: [clearFlowLeads(content)], keepTogether: true }],
+      decoration: { borderColor: "000000", borderWidthMm: 0, paddingXMm: 0, paddingYMm: 0 },
+    });
+  }
+  return result;
+}
