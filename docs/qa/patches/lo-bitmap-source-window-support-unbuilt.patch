+
+CPPUNIT_TEST_FIXTURE(SvdrawTest, testBitmapFillSourceWindow)
+{
+    using drawinglayer::attribute::SdrFillGraphicAttribute;
+    Bitmap aBitmap(Size(120, 180), vcl::PixelFormat::N24_BPP);
+    aBitmap.Erase(COL_LIGHTBLUE);
+    const BitmapEx aOriginal(aBitmap);
+    const Graphic aGraphic(aOriginal);
+    const basegfx::B2DVector aLogicSize(3175.0, 4763.0);
+    const basegfx::B2DVector aZero(0.0, 0.0);
+    const basegfx::B2DRange aTarget(0.0, 0.0, 3400.0, 3400.0);
+    const basegfx::B2DRange aUnit(0.0, 0.0, 1.0, 1.0);
+    const SdrFillGraphicAttribute aLegacy(aGraphic, aLogicSize, aZero, aZero, aZero,
+                                         aZero, false, true, true);
+    CPPUNIT_ASSERT(aLegacy.createFillGraphicAttribute(aTarget).getGraphicRange() == aUnit);
+
+    auto makeFill = [&](const basegfx::B2DRange& rSource) {
+        return SdrFillGraphicAttribute(aGraphic, aLogicSize, aZero, aZero, aZero,
+                                       aZero, false, true, true, rSource);
+    };
+    const auto aCropped = makeFill(basegfx::B2DRange(0.084, 0.244, 0.884, 0.77733));
+    const auto aFill = aCropped.createFillGraphicAttribute(aTarget);
+    CPPUNIT_ASSERT(aFill.getGraphic().GetBitmapEx() == aOriginal);
+    CPPUNIT_ASSERT(aFill.getGraphic().GetBitmapEx().GetSizePixel() == Size(120, 180));
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(-0.105, aFill.getGraphicRange().getMinX(), 1e-12);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.25, aFill.getGraphicRange().getWidth(), 1e-12);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(-0.244 / 0.53333, aFill.getGraphicRange().getMinY(), 1e-12);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.0 / 0.53333, aFill.getGraphicRange().getHeight(), 1e-12);
+
+    // Source-window changes must invalidate cached fill attributes.
+    CPPUNIT_ASSERT(aCropped == makeFill(basegfx::B2DRange(0.084, 0.244, 0.884, 0.77733)));
+    CPPUNIT_ASSERT(!(aCropped == aLegacy));
+    CPPUNIT_ASSERT(!(aCropped == makeFill(basegfx::B2DRange(0.1, 0.2, 0.9, 0.8))));
+    CPPUNIT_ASSERT(makeFill(basegfx::B2DRange()).createFillGraphicAttribute(aTarget).isDefault());
+
+    const auto aPadded = makeFill(basegfx::B2DRange(-0.1, -0.2, 1.3, 1.4))
+                             .createFillGraphicAttribute(aTarget);
+    CPPUNIT_ASSERT(aPadded.getGraphic().GetBitmapEx() == aOriginal);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(0.1 / 1.4, aPadded.getGraphicRange().getMinX(), 1e-12);
+    CPPUNIT_ASSERT_DOUBLES_EQUAL(1.0 / 1.4, aPadded.getGraphicRange().getWidth(), 1e-12);
 }
 
